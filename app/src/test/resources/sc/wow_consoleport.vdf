"controller_mappings"
{
	"version"		"3"
	"title"		"WoW 3.3.5a — ConsolePort (no WoWpadX)"
	"description"		"Emits ConsolePort's WoWmapper keys directly, so WoWpadX is not needed. Key map taken from the live Interface/AddOns/ConsolePort/Controllers/WoWmapper.lua: faces F9-F12, d-pad F1-F4, View F5, Menu F6, T1/T2 F7/F8, CP_X_CENTER NUMPADPLUS (this install's patched value), TOGGLERUN NUMPADDIVIDE. Modifiers per Config/Binds.lua: CP_M1=SHIFT (left bumper), CP_M2=CTRL (left trigger)."
	"controller_type"		"controller_triton"
	"group"
	{
		"id"		"0"
		"mode"		"four_buttons"
		"inputs"
		{
			"button_a" { "activators" { "Full_Press" { "bindings" { "binding" "key_press F11" } } } }
			"button_b" { "activators" { "Full_Press" { "bindings" { "binding" "key_press F10" } } } }
			"button_x" { "activators" { "Full_Press" { "bindings" { "binding" "key_press F12" } } } }
			"button_y" { "activators" { "Full_Press" { "bindings" { "binding" "key_press F9" } } } }
		}
	}
	"group"
	{
		"id"		"1"
		"mode"		"dpad"
		"inputs"
		{
			"dpad_north" { "activators" { "Full_Press" { "bindings" { "binding" "key_press W" } } } }
			"dpad_south" { "activators" { "Full_Press" { "bindings" { "binding" "key_press S" } } } }
			"dpad_west" { "activators" { "Full_Press" { "bindings" { "binding" "key_press A" } } } }
			"dpad_east" { "activators" { "Full_Press" { "bindings" { "binding" "key_press D" } } } }
			"click" { "activators" { "Full_Press" { "bindings" { "binding" "key_press SPACE" } } } }
		}
		"settings" { "deadzone_inner_radius" "6000" }
	}
	"group"
	{
		"id"		"2"
		"mode"		"joystick_mouse"
		"inputs"
		{
			"click" { "activators" { "Full_Press" { "bindings" { "binding" "key_press KEYPAD_DIVIDE" } } } }
		}
		"settings" { "sensitivity" "110" "deadzone_inner_radius" "4000" }
	}
	"group"
	{
		"id"		"3"
		"mode"		"trigger"
		"inputs"
		{
			"click" { "activators" { "Full_Press" { "bindings" { "binding" "key_press LEFT_CONTROL" } } } }
		}
		"settings" { "adaptive_threshold" "1" }
	}
	"group"
	{
		"id"		"4"
		"mode"		"trigger"
		"inputs"
		{
			"click" { "activators" { "Full_Press" { "bindings" { "binding" "key_press F8" } } } }
		}
		"settings" { "adaptive_threshold" "1" }
	}
	"group"
	{
		"id"		"5"
		"mode"		"dpad"
		"inputs"
		{
			"dpad_north" { "activators" { "Full_Press" { "bindings" { "binding" "key_press F1" } } } }
			"dpad_south" { "activators" { "Full_Press" { "bindings" { "binding" "key_press F3" } } } }
			"dpad_west" { "activators" { "Full_Press" { "bindings" { "binding" "key_press F4" } } } }
			"dpad_east" { "activators" { "Full_Press" { "bindings" { "binding" "key_press F2" } } } }
			"click" { "activators" { "Full_Press" { "bindings" { "binding" "key_press TAB" } } } }
		}
	}
	"group"
	{
		"id"		"6"
		"mode"		"mouse"
		"inputs"
		{
			"click" { "activators" { "Full_Press" { "bindings" { "binding" "mouse_button LEFT" } } } }
		}
		"settings" { "sensitivity" "130" }
	}
	"group"
	{
		"id"		"7"
		"mode"		"switches"
		"inputs"
		{
			"left_bumper" { "activators" { "Full_Press" { "bindings" { "binding" "key_press LEFT_SHIFT" } } } }
			"right_bumper" { "activators" { "Full_Press" { "bindings" { "binding" "key_press F7" } } } }
			"button_menu" { "activators" { "Full_Press" { "bindings" { "binding" "key_press F6" } } } }
			"button_escape" { "activators" { "Full_Press" { "bindings" { "binding" "key_press F5" } } } }
			"button_back_right" { "activators" { "Full_Press" { "bindings" { "binding" "key_press KEYPAD_PLUS" } } } }
			"button_back_left" { "activators" { "Full_Press" { "bindings" { "binding" "key_press SPACE" } } } }
			"button_back_right_upper" { "activators" { "Full_Press" { "bindings" { "binding" "key_press KEYPAD_DIVIDE" } } } }
			"button_back_left_upper" { "activators" { "Full_Press" { "bindings" { "binding" "key_press TAB" } } } }
		}
	}
	"group"
	{
		"id"		"8"
		"mode"		"dpad"
		"inputs"
		{
			"dpad_north" { "activators" { "Full_Press" { "bindings" { "binding" "key_press F1" } } } }
			"dpad_south" { "activators" { "Full_Press" { "bindings" { "binding" "key_press F3" } } } }
			"dpad_west" { "activators" { "Full_Press" { "bindings" { "binding" "key_press F4" } } } }
			"dpad_east" { "activators" { "Full_Press" { "bindings" { "binding" "key_press F2" } } } }
		}
	}
	"group"
	{
		"id"		"9"
		"mode"		"gyro_to_mouse"
		"inputs" {}
		"settings" { "sensitivity" "90" }
	}
	"preset"
	{
		"id"		"0"
		"name"		"Default"
		"group_source_bindings"
		{
			"0"		"button_diamond active"
			"1"		"joystick active"
			"2"		"right_joystick active"
			"3"		"left_trigger active"
			"4"		"right_trigger active"
			"5"		"left_trackpad active"
			"6"		"right_trackpad active"
			"7"		"switch active"
			"8"		"dpad active"
			"9"		"gyro active"
		}
	}
}
