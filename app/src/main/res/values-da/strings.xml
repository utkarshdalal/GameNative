    <string name="box86_64_env_var_help__dynarec_safeflags"><![CDATA[
        Håndtering af flag på CALL/RET-opcodes<br /><br />
        <b>0</b> : Behandler CALL/RET som om de aldrig krævede flag (hurtigere, ustabilt)<br />
        <b>1</b> : De fleste RET kræver flag, de fleste CALL ikke<br />
        <b>2</b> : Alle CALL/RET kræver flag (langsommere)
    ]]>    </string>
    <string name="box86_64_env_var_help__dynarec_fastnan">Generering af -NAN som på x86</string>
    <string name="box86_64_env_var_help__dynarec_fastround">Generering af præcis x86-afrunding</string>
    <string name="box86_64_env_var_help__dynarec_x87double">Brug af Float/Double til x87-emulering</string>
    <string name="box86_64_env_var_help__dynarec_bigblock"><![CDATA[
        Dynarec opbygning af BigBlock<br /><br />
        <b>0</b> : Forsøg ikke at bygge blokken så stor som muligt<br />
        <b>1</b> : Byg Dynarec-blokken så stor som muligt<br />
        <b>2</b> : Byg blokke større (fortsæt når blok overlapper, men kun for blokke i ELF-hukommelse)<br />
        <b>3</b> : Byg blokke større (fortsæt når blok overlapper, for alle typer hukommelse)
    ]]>    </string>
    <string name="box86_64_env_var_help__dynarec_strongmem"><![CDATA[
        Simulation af Strong Memory-model<br /><br />
        <b>0</b> : Gør intet særligt<br />
        <b>1</b> : Aktiver Memory Barrier ved skrivning til hukommelse (på visse MOV-opkoder)<br />
        <b>2</b> : Som 1 + Memory Barrier på hver MOV-skrivning<br />
        <b>3</b> : Som 2 + Memory Barrier ved læsning fra hukommelse og på nogle SSE/SSE2-opkoder
    ]]>    </string>
    <string name="box86_64_env_var_help__dynarec_forward">Definerer maksimal tilladt fremadværdi ved opbygning af blokke</string>
