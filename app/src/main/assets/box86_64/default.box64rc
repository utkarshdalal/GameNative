[steam.exe]
BOX64_ENV=WINEARGS=-no-browser -noreactlogin -noverifyfiles -nobootstrapupdate -skipinitialbootstrap -norepairfiles -no-dwrite -nobigpicture -cef-single-process -cef-in-process-gpu -single_core -cef-disable-d3d11 -cef-disable-sandbox -disable-winh264 -no-cef-sandbox -vrdisable -cef-disable-breakpad -silent -cef-disable-gpu steam://open/minigameslist
BOX64_ENV1=WINEDLLOVERRIDES=gameoverlayui,gameoverlayui64.exe=d

[steamwebhelper.exe]
BOX64_DYNAREC_STRONGMEM=1

[MgsGroundZeroes.exe]
BOX64_ENV=WINEFORCENTCONTINUE=1

[farcry3.exe]
BOX64_ENV=WINE_DO_NOT_OPEN_SC_MANAGER=1

[farcry3_d3d11.exe]
BOX64_ENV=WINE_DO_NOT_OPEN_SC_MANAGER=1

[FarCry4.exe]
BOX64_ENV=WINVERSION=winxp

[watch_dogs.exe]
BOX64_ENV=WINVERSION=winxp

[ffxiiiimg.exe]
BOX64_ENV=WINEARGS=-FullScreenMode=Force -Shadow=512 -Msaa=2

[kof13_win32_Release.exe]
BOX64_ENV1=WINEDLLOVERRIDES=quartz=d

[DXMD.exe]
BOX64_ENV=WINEVMEMMAXSIZE=16384

[rage.exe]
BOX64_ENV=ZINK_CONTEXT_THREADED=0

[rage64.exe]
BOX64_ENV=ZINK_CONTEXT_THREADED=0
