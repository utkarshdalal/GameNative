    "GAMEPAD_BUTTON_Y": "KEY_Y",
    "GAMEPAD_BUTTON_L1": "KEY_Q",
    "GAMEPAD_BUTTON_R1": "KEY_E",
    "GAMEPAD_BUTTON_START": "KEY_ESC",
    "GAMEPAD_BUTTON_SELECT": "KEY_SHIFT_L",
    "GAMEPAD_DPAD_UP": "KEY_W",
    "GAMEPAD_DPAD_DOWN": "KEY_S",
    "GAMEPAD_DPAD_LEFT": "KEY_A",
    "GAMEPAD_DPAD_RIGHT": "KEY_D",
    "GAMEPAD_LEFT_THUMB_UP": "KEY_W",
    "GAMEPAD_LEFT_THUMB_DOWN": "KEY_S",
    "GAMEPAD_LEFT_THUMB_LEFT": "KEY_A",
    "GAMEPAD_LEFT_THUMB_RIGHT": "KEY_D",
