<variables>
    <!-- Colors -->
    <var name="textColor" value="#FFFFFFFF" />
    <var name="highlightColor" value="#4CAF50" />

    <!-- Highlight styling -->
    <var name="highlightOpacity" value="0.9" />
    <var name="highlightBorderWidth" value="3" />
    <var name="highlightTransitionSpeed" value="150" />

    <!-- Card dimensions -->
    <var name="cornerRadius" value="8" />
    <var name="cellSize" value="100" />
    <var name="gridSpacing" value="8" />
    <var name="borderWidth" value="4" />
    <var name="borderColor" value="#55FFFFFF" />

    <!-- Spacing -->
    <var name="paddingSmall" value="8" />
    <var name="paddingMedium" value="16" />
    <var name="bottomOffset" value="24" />

    <!-- Top bar -->
    <var name="topBarHeight" value="72" />
    <var name="searchBarWidth" value="500" />
    <var name="searchBarX" value="200" />
    <var name="searchBarY" value="12" />
    <var name="profileButtonY" value="12" />
    <var name="gridPaddingTop" value="88" />

    <!-- Portrait overrides -->
    <breakpoint orientation="portrait">
        <var name="cellSize" value="85" />
        <var name="gridSpacing" value="6" />
        <var name="topBarHeight" value="130" />
        <var name="gridPaddingTop" value="150" />
        <var name="searchBarWidth" value="90%" />
        <var name="searchBarX" value="5%" />
        <var name="searchBarY" value="75" />
        <var name="profileButtonY" value="10" />
    </breakpoint>
</variables>
