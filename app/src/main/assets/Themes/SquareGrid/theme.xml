<theme>
    <elements>
        <card id="squareCard" width="100%" height="100%">
            <!-- Square game cover - fills entire card -->
            <image id="cover" x="0" y="0" width="100%" height="100%"
                   src="@{game.cover}" cornerRadius="@{vars.cornerRadius}" scaleType="cover" />

            <!-- Installed checkmark (bottom-left) -->
            <rect id="installedBg" x="6" y="6" width="24" height="24"
                  color="#CC000000" cornerRadius="12" anchor="bottomLeft"
                  visibleWhen="game.isInstalled" />
            <text id="installedIcon" x="6" y="6" width="24" height="24"
                  text="✓" textSize="14" color="#FF4CAF50" fontWeight="bold"
                  textAlign="center" anchor="bottomLeft"
                  visibleWhen="game.isInstalled" />

            <!-- Compatibility indicator (top-right) - colored dot -->
            <rect id="compatBg" x="6" y="6" width="18" height="18"
                  color="#AA000000" cornerRadius="9" anchor="topRight" />
            <rect id="compatDot" x="9" y="9" width="12" height="12"
                  color="@{game.compatibility.color}" cornerRadius="6" anchor="topRight" />

            <!-- Card outline - visible border -->
            <border id="cardBorder" x="0" y="0" width="100%" height="100%"
                    strokeWidth="@{vars.borderWidth}" color="@{vars.borderColor}" cornerRadius="@{vars.cornerRadius}" />
        </card>
    </elements>

    <layout>
        <!-- True square grid -->
        <grid navigationId="grid"
              cellWidth="@{vars.cellSize}" aspectRatio="1"
              hSpacing="@{vars.gridSpacing}" vSpacing="@{vars.gridSpacing}"
              padding="@{vars.gridPaddingTop} @{vars.paddingMedium}"
              selectionMode="moving" itemCard="squareCard"
              highlightBorderWidth="@{vars.borderWidth}" highlightCornerRadius="@{vars.cornerRadius}"
              navigateRight="filterBtn" navigateDown="filterBtn" navigateUp="searchBar" />

        <!-- Top bar with header, search, and profile -->
        <fixed id="topBar" backgroundColor="#CC000000" height="@{vars.topBarHeight}">
            <header x="@{vars.paddingMedium}" y="8" anchor="topLeft"
                textColor="@{vars.textColor}" showAppName="true" showGameCount="true" />
            <searchBar navigationId="searchBar"
                x="@{vars.searchBarX}" y="@{vars.searchBarY}" width="@{vars.searchBarWidth}" height="56"
                anchor="topLeft" backgroundColor="#FF1E1E1E" borderRadius="24"
                highlightColor="@{vars.highlightColor}" highlightOpacity="@{vars.highlightOpacity}"
                highlightBorderWidth="@{vars.highlightBorderWidth}" highlightTransitionSpeed="@{vars.highlightTransitionSpeed}"
                navigateDown="grid" />
            <profileButton x="@{vars.paddingMedium}" y="@{vars.profileButtonY}" anchor="topRight" size="56"
                iconSize="36" padding="10"
                backgroundColor="#66808080" cornerRadius="12"
                highlightColor="@{vars.highlightColor}" highlightOpacity="@{vars.highlightOpacity}"
                highlightBorderWidth="@{vars.highlightBorderWidth}" highlightTransitionSpeed="@{vars.highlightTransitionSpeed}"
                navigateDown="grid" />
        </fixed>

        <!-- Bottom bar with filter and add buttons -->
        <fixed id="bottomBar">
            <filterButton navigationId="filterBtn"
                          x="80" y="@{vars.bottomOffset}" anchor="bottomRight" expanded="true"
                          cornerRadius="28" size="56" iconSize="24"
                          highlightColor="@{vars.highlightColor}" highlightOpacity="@{vars.highlightOpacity}"
                          highlightBorderWidth="@{vars.highlightBorderWidth}" highlightTransitionSpeed="@{vars.highlightTransitionSpeed}"
                          navigateLeft="grid" />
            <addButton x="@{vars.paddingMedium}" y="@{vars.bottomOffset}" anchor="bottomRight"
                       cornerRadius="28" size="56" iconSize="24"
                       highlightColor="@{vars.highlightColor}" highlightOpacity="@{vars.highlightOpacity}"
                       highlightBorderWidth="@{vars.highlightBorderWidth}" highlightTransitionSpeed="@{vars.highlightTransitionSpeed}" />
        </fixed>
    </layout>
</theme>
