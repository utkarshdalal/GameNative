<theme>
    <!-- Top bar with header, search, and profile -->
    <fixed id="topBar">
        <header x="@{vars.paddingMedium}" y="@{vars.paddingSmall}" anchor="topLeft"
                textColor="@{vars.textColor}" showAppName="true" showThemeName="true" showGameCount="true" />
        <searchBar x="200" y="@{vars.paddingSmall}" width="600" height="48" anchor="topLeft"
                   backgroundColor="@{vars.searchBarBg}" borderRadius="@{vars.searchBarRadius}" />
        <profileButton x="@{vars.paddingMedium}" y="@{vars.paddingSmall}" anchor="topRight" size="40" />
    </fixed>

    <!-- Bottom action buttons -->
    <fixed id="bottomBar">
        <filterButton x="100" y="@{vars.bottomOffset}" anchor="bottomRight" expanded="true" />
        <addButton x="@{vars.paddingMedium}" y="@{vars.bottomOffset}" anchor="bottomRight" />
    </fixed>

    <!-- Card definitions - Big picture carousel style -->
    <cards>
        <card id="big" width="@{vars.cardWidth}" height="@{vars.cardHeight}">
            <!-- Large hero image -->
            <image id="hero" x="0" y="0" width="@{vars.cardWidth}" height="@{vars.cardHeight}"
                   src="@{game.hero}" cornerRadius="@{vars.cornerRadius}" />

            <!-- Subtle shade overlay -->
            <rect id="shade" x="0" y="0" width="@{vars.cardWidth}" height="@{vars.cardHeight}"
                  color="@{vars.overlayColor}" />

            <!-- Game title at bottom -->
            <text id="title" x="@{vars.paddingLarge}" y="380" width="752" height="48"
                  text="@{game.title}" textSize="@{vars.textSizeTitle}"
                  color="@{vars.textColor}" maxLines="1" />
        </card>
    </cards>

    <!-- Layout - big picture style carousel -->
    <layout>
        <carousel direction="right" itemWidth="820" itemHeight="462"
                  itemSpacing="@{vars.itemSpacing}" selectionMode="stationary" itemCard="big" />
    </layout>
</theme>
