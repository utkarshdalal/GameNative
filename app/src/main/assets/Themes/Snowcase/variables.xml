<variables>
    <!-- Colors (used multiple times) -->
    <var name="textColor" value="#FF000000" />
    <var name="headerTextColor" value="#FF000000" />
    <var name="statusTextColor" value="#FF666666" />
    <var name="highlightColor" value="#FF9C27B0" />

    <!-- Highlight styling (used by multiple elements) -->
    <var name="highlightOpacity" value="1.0" />
    <var name="highlightBorderWidth" value="4" />
    <var name="highlightTransitionSpeed" value="200" />

    <!-- Focus border for carousel items -->
    <var name="focusBorderWidth" value="3" />

    <!-- Shared spacing -->
    <var name="paddingMedium" value="16" />
    <var name="bottomOffset" value="24" />

    <!-- Animation -->
    <var name="transitionSpeed" value="200" />

    <!-- Card layout -->
    <var name="cardWidth" value="600" />
    <var name="cardHeight" value="100" />
    <var name="imageSize" value="100" />
    <var name="cornerRadius" value="12" />
    <!-- Text info appears to the right when focused (positions scale with card) -->
    <var name="infoX" value="115" />
    <var name="infoWidth" value="280" />

    <!-- Text (sizes scale with focusedScale) -->
    <var name="titleSize" value="18" />
    <var name="subtitleSize" value="9" />
    <var name="statusSize" value="7" />
    <!-- X position for install status (offset for checkmark) -->
    <var name="statusX" value="125" />

    <!-- Top bar -->
    <var name="topBarHeight" value="72" />
    <var name="searchBarWidth" value="280" />
    <var name="searchBarY" value="12" />
    <var name="profileButtonY" value="14" />

    <!-- Carousel -->
    <var name="bgOpacity" value="0.12" />
    <var name="carouselOffsetX" value="-75" />
    <var name="itemSpacing" value="10" />
    <var name="focusedScale" value="2" />
    <var name="focusedOffsetX" value="300" />
    <var name="focusedSpacing" value="50" />

    <!-- Image position -->
    <var name="imageX" value="0" />
    <var name="imageY" value="0" />

    <!-- Info text position (relative to card, appears right of image in landscape) -->
    <var name="infoY" value="-5" />
    <var name="compatY" value="10" />
    <var name="statusY" value="20" />
    <var name="lastPlayedY" value="30" />
    <var name="clockIconY" value="39" />
    <var name="clockIconSize" value="6" />

    <!-- Footer overlay for portrait mode (text inside card) -->
    <var name="footerHeight" value="0" />
    <var name="footerColor" value="#00000000" />

    <!-- Portrait overrides -->
    <breakpoint orientation="portrait">
        <var name="topBarHeight" value="120" />
        <var name="searchBarWidth" value="55%" />
        <var name="searchBarY" value="15" />
        <var name="profileButtonY" value="15" />

        <!-- Square card in portrait - text overlaid on image -->
        <var name="cardWidth" value="300" />
        <var name="cardHeight" value="140" />
        <var name="imageSize" value="140" />
        <var name="cornerRadius" value="12" />

        <!-- Text inside card at bottom -->
        <var name="infoX" value="6" />
        <var name="infoWidth" value="128" />
        <var name="infoY" value="80" />
        <var name="compatY" value="92" />
        <var name="statusY" value="104" />
        <var name="lastPlayedY" value="116" />
        <var name="clockIconY" value="125" />
        <var name="clockIconSize" value="6" />
        <var name="titleWidth" value="100" />

        <!-- Footer overlay for text readability -->
        <var name="footerHeight" value="70" />
        <var name="footerColor" value="#99000000" />

        <!-- Text color changes to white on dark overlay -->
        <var name="textColor" value="#FFFFFFFF" />
        <var name="headerTextColor" value="#FF000000" />
        <var name="statusTextColor" value="#CCFFFFFF" />

        <var name="carouselOffsetX" value="-10" />
        <var name="itemSpacing" value="14" />
        <var name="focusedScale" value="1.5" />
        <var name="focusedOffsetX" value="72" />
        <var name="focusedSpacing" value="35" />
        <var name="bgOpacity" value="0.10" />

        <var name="titleSize" value="12" />
        <var name="subtitleSize" value="9" />
        <var name="statusSize" value="8" />
        <var name="statusX" value="16" />
    </breakpoint>
</variables>
