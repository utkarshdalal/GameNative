<theme>
    <elements>
        <!-- Card for vertical carousel - shows info when focused -->
        <card id="gameCard" width="@{vars.cardWidth}" height="@{vars.cardHeight}">
            <!-- Game image -->
            <image id="cover"
                   x="@{vars.imageX}" y="@{vars.imageY}"
                   width="@{vars.imageSize}" height="@{vars.imageSize}"
                   src="@{game.capsule}"
                   fallback="@{game.hero}"
                   cornerRadius="@{vars.cornerRadius}"
                   scaleType="cover" />

            <!-- Border overlay -->
            <rect id="border"
                  x="@{vars.imageX}" y="@{vars.imageY}"
                  width="@{vars.imageSize}" height="@{vars.imageSize}"
                  color="#00000000"
                  borderWidth="2"
                  borderColor="#33000000"
                  cornerRadius="@{vars.cornerRadius}" />

            <!-- Focus border around image only - uses theme gradient -->
            <rect id="focusBorder"
                  x="@{vars.imageX}" y="@{vars.imageY}"
                  width="@{vars.imageSize}" height="@{vars.imageSize}"
                  color="#00000000"
                  borderWidth="@{vars.focusBorderWidth}"
                  borderGradient="true"
                  cornerRadius="@{vars.cornerRadius}"
                  focusOnly="true"
                  focusTransitionSpeed="@{vars.transitionSpeed}" />

            <!-- Footer overlay for text readability (portrait mode) -->
            <rect id="footer"
                  x="@{vars.imageX}" y="0"
                  width="@{vars.imageSize}" height="@{vars.footerHeight}"
                  color="@{vars.footerColor}"
                  cornerRadius="0 0 @{vars.cornerRadius} @{vars.cornerRadius}"
                  anchor="bottomLeft"
                  focusOnly="true"
                  focusTransitionSpeed="@{vars.transitionSpeed}" />

            <!-- Game title - large and bold, shown when focused -->
            <text id="title"
                  x="@{vars.infoX}" y="@{vars.infoY}"
                  width="@{vars.infoWidth}"
                  text="@{game.title}"
                  textSize="@{vars.titleSize}"
                  color="@{vars.textColor}"
                  maxLines="1"
                  overflow="ellipsis"
                  fontWeight="bold"
                  anchor="topLeft"
                  focusOnly="true"
                  focusTransitionSpeed="@{vars.transitionSpeed}" />

            <!-- Compatibility label - smaller subtitle style -->
            <text id="compatLabel"
                  x="@{vars.infoX}" y="@{vars.compatY}"
                  width="@{vars.infoWidth}"
                  text="@{game.compatibility.label}"
                  textSize="@{vars.subtitleSize}"
                  color="@{game.compatibility.color}"
                  maxLines="1"
                  fontWeight="semibold"
                  anchor="topLeft"
                  focusOnly="true"
                  focusTransitionSpeed="@{vars.transitionSpeed}" />

            <!-- Installed checkmark - shown next to status when installed -->
            <text id="installedCheck"
                  x="@{vars.infoX}" y="@{vars.statusY}"
                  text="✓"
                  textSize="@{vars.statusSize}"
                  color="#FF4CAF50"
                  fontWeight="bold"
                  anchor="topLeft"
                  focusOnly="true"
                  focusTransitionSpeed="@{vars.transitionSpeed}"
                  visibleWhen="game.isInstalled" />

            <!-- Install status - small info text, only shown when installed -->
            <text id="installStatus"
                  x="@{vars.statusX}" y="@{vars.statusY}"
                  width="@{vars.infoWidth}"
                  text="@{game.installStatus}"
                  textSize="@{vars.statusSize}"
                  color="@{vars.statusTextColor}"
                  maxLines="1"
                  anchor="topLeft"
                  focusOnly="true"
                  focusTransitionSpeed="@{vars.transitionSpeed}"
                  visibleWhen="game.isInstalled" />

            <!-- Last played clock icon - landscape (dark icon for light theme) -->
            <image id="lastPlayedIconLandscape"
                   x="@{vars.infoX}" y="@{vars.clockIconY}"
                   width="@{vars.clockIconSize}" height="@{vars.clockIconSize}"
                   scaleType="cover"
                   src="assets/clock.png"
                   anchor="topLeft"
                   focusOnly="true"
                   focusTransitionSpeed="@{vars.transitionSpeed}"
                   visibleWhen="game.isInstalled"
                   visibility="landscape" />

            <!-- Last played clock icon - portrait (white icon for dark overlay) -->
            <image id="lastPlayedIconPortrait"
                   x="@{vars.infoX}" y="@{vars.clockIconY}"
                   width="@{vars.clockIconSize}" height="@{vars.clockIconSize}"
                   scaleType="cover"
                   src="assets/clock-white.png"
                   anchor="topLeft"
                   focusOnly="true"
                   focusTransitionSpeed="@{vars.transitionSpeed}"
                   visibleWhen="game.isInstalled"
                   visibility="portrait" />

            <!-- Last played time - offset by icon width -->
            <text id="lastPlayed"
                  x="@{vars.statusX}" y="@{vars.lastPlayedY}"
                  width="@{vars.infoWidth}"
                  text="@{game.lastPlayed}"
                  textSize="@{vars.statusSize}"
                  color="@{vars.statusTextColor}"
                  maxLines="1"
                  anchor="topLeft"
                  focusOnly="true"
                  focusTransitionSpeed="@{vars.transitionSpeed}"
                  visibleWhen="game.isInstalled" />
        </card>
    </elements>

    <layout>
        <!-- White background -->
        <fixed id="background">
            <rect x="0" y="0" width="100%" height="100%" color="#FFFFFFFF" />
        </fixed>

        <!-- Vertical carousel with backdrop image -->
        <carousel navigationId="carousel"
                  orientation="vertical"
                  centerFocus="true"
                  horizontalAlign="start"
                  horizontalOffset="@{vars.carouselOffsetX}"
                  itemWidth="@{vars.cardWidth}"
                  itemHeight="@{vars.cardHeight}"
                  itemSpacing="@{vars.itemSpacing}"
                  focusedScale="@{vars.focusedScale}"
                  selectionMode="stationary"
                  itemCard="gameCard"
                  focusedBackground="@{game.libraryHero}"
                  backgroundOpacity="@{vars.bgOpacity}"
                  focusedOffsetX="@{vars.focusedOffsetX}"
                  focusedSpacing="@{vars.focusedSpacing}"
                  backgroundTransitionSpeed="400"
                  highlightBorderWidth="0"
                  navigateRight="filterBtn" />

        <!-- Top bar -->
        <fixed id="topBar" height="@{vars.topBarHeight}">
            <header x="@{vars.paddingMedium}" y="8"
                    anchor="topLeft"
                    textColor="@{vars.headerTextColor}"
                    showAppName="true"
                    showGameCount="true" />
            <searchBar navigationId="searchBtn"
                       x="76" y="@{vars.searchBarY}"
                       width="@{vars.searchBarWidth}" height="48"
                       anchor="topRight"
                       backgroundColor="#DDFFFFFF"
                       textColor="#FF000000"
                       borderRadius="24"
                       collapsible="true"
                       highlightColor="@{vars.highlightColor}"
                       highlightOpacity="@{vars.highlightOpacity}"
                       highlightBorderWidth="@{vars.highlightBorderWidth}"
                       highlightTransitionSpeed="@{vars.highlightTransitionSpeed}"
                       navigateRight="profileBtn" navigateDown="filterBtn" navigateLeft="carousel" />
            <profileButton navigationId="profileBtn"
                           x="16" y="@{vars.profileButtonY}"
                           anchor="topRight"
                           size="44"
                           iconSize="44"
                           padding="2"
                           backgroundColor="#DDFFFFFF"
                           cornerRadius="22"
                           highlightColor="@{vars.highlightColor}"
                           highlightOpacity="@{vars.highlightOpacity}"
                           highlightBorderWidth="@{vars.highlightBorderWidth}"
                           highlightTransitionSpeed="@{vars.highlightTransitionSpeed}"
                           navigateDown="addGameBtn" navigateLeft="searchBtn" />
        </fixed>

        <!-- Bottom bar -->
        <fixed id="bottomBar">
            <filterButton navigationId="filterBtn"
                          x="88" y="@{vars.bottomOffset}"
                          anchor="bottomRight"
                          expanded="true"
                          cornerRadius="16"
                          size="56"
                          iconSize="24"
                          highlightColor="@{vars.highlightColor}"
                          highlightOpacity="@{vars.highlightOpacity}"
                          highlightBorderWidth="@{vars.highlightBorderWidth}"
                          highlightTransitionSpeed="@{vars.highlightTransitionSpeed}"
                          navigateUp="searchBtn" navigateRight="addGameBtn" navigateLeft="carousel" />
            <addButton navigationId="addGameBtn"
                       x="@{vars.paddingMedium}" y="@{vars.bottomOffset}"
                       anchor="bottomRight"
                       cornerRadius="16"
                       size="56"
                       iconSize="24"
                       highlightColor="@{vars.highlightColor}"
                       highlightOpacity="@{vars.highlightOpacity}"
                       highlightBorderWidth="@{vars.highlightBorderWidth}"
                       highlightTransitionSpeed="@{vars.highlightTransitionSpeed}"
                       navigateUp="profileBtn" navigateLeft="filterBtn" />
        </fixed>
    </layout>
</theme>
