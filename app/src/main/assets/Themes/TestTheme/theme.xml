<?xml version="1.0" encoding="utf-8"?>
<!--
    TEST THEME - Comprehensive demonstration of all theme engine features

    This theme showcases:
    - All fixed element types (Header, SearchBar, ProfileButton, FilterButton, AddButton)
    - All layer types (Image, Video, Rect, Shadow, Border, Text, Backdrop, Button)
    - All common attributes (anchor, visibility, opacity, focusOnly, visibleWhen, zIndex)
    - Breakpoint-responsive variables
    - Grid layout with separator
    - New layout-centric architecture with <elements> and <layout>
-->
<theme>
    <!-- ================================================================
         ELEMENTS - Reusable definitions for cards and fixed containers
         ================================================================ -->
    <elements>

        <!-- MAIN CARD: Demonstrates all layer types -->
        <card id="mainCard" width="@{vars.cellWidth}" height="@{vars.cellHeight}">

            <!-- LAYER 1: Shadow (renders behind everything) - now supports cornerRadius -->
            <shadow
                id="cardShadow"
                x="4" y="4"
                width="100%" height="100%"
                radius="@{vars.shadowRadius}"
                color="@{vars.shadowColor}"
                cornerRadius="@{vars.cornerRadius}"
                zIndex="-2" />

            <!-- LAYER 2: Background rect with border -->
            <rect
                id="cardBg"
                x="0" y="0"
                width="100%" height="100%"
                color="@{vars.cardBgColor}"
                cornerRadius="@{vars.cornerRadius}"
                borderWidth="1"
                borderColor="@{vars.borderColor}"
                zIndex="-1" />

            <!-- LAYER 3: Game hero/cover image -->
            <image
                id="gameImage"
                x="0" y="0"
                width="100%" height="@{vars.imageHeight}"
                src="@{game.hero}"
                fallback="@{game.capsule}"
                cornerRadius="@{vars.cornerRadius} @{vars.cornerRadius} 0 0"
                scaleType="cover"
                zIndex="0" />

            <!-- LAYER 4: Gradient overlay on image (for text readability) -->
            <rect
                id="imageOverlay"
                x="0" y="0"
                width="100%" height="@{vars.imageHeight}"
                color="#00000000"
                cornerRadius="@{vars.cornerRadius} @{vars.cornerRadius} 0 0"
                zIndex="1" />

            <!-- LAYER 5: Compatibility badge (top-left) -->
            <rect
                id="compatBadgeBg"
                x="@{vars.paddingSmall}" y="@{vars.paddingSmall}"
                width="80" height="20"
                color="@{vars.overlayColor}"
                cornerRadius="4"
                anchor="topLeft"
                zIndex="2" />

            <text
                id="compatLabel"
                x="@{vars.paddingSmall}" y="@{vars.paddingSmall}"
                width="80" height="20"
                text="@{game.compatibility.label}"
                textSize="@{vars.textSizeSmall}"
                color="@{game.compatibility.color}"
                textAlign="center"
                fontWeight="bold"
                anchor="topLeft"
                zIndex="3" />

            <!-- LAYER 6: Installed indicator (top-right, conditional) -->
            <text
                id="installedBadge"
                x="@{vars.paddingSmall}" y="@{vars.paddingSmall}"
                text="✓ Installed"
                textSize="@{vars.textSizeSmall}"
                color="#FF4CAF50"
                fontWeight="bold"
                anchor="topRight"
                visibleWhen="game.isInstalled"
                zIndex="3" />

            <!-- LAYER 7: Game title -->
            <text
                id="gameTitle"
                x="@{vars.paddingSmall}" y="@{vars.infoY}"
                width="280" height="@{vars.titleHeight}"
                text="@{game.title}"
                textSize="@{vars.textSizeTitle}"
                color="@{vars.textColor}"
                maxLines="1"
                fontWeight="bold"
                textAlign="left"
                anchor="topLeft"
                zIndex="2" />

            <!-- LAYER 8: Installation status (demonstrating new text attributes) -->
            <text
                id="installStatus"
                x="@{vars.paddingSmall}" y="@{vars.statusY}"
                width="200" height="20"
                text="@{game.installStatus}"
                textSize="@{vars.textSizeSmall}"
                color="@{vars.textColorMuted}"
                fontStyle="italic"
                letterSpacing="0.5"
                anchor="topLeft"
                zIndex="2" />

            <!-- LAYER 9: Focus-only border (appears when card is focused) -->
            <border
                id="focusBorder"
                x="0" y="0"
                width="100%" height="100%"
                strokeWidth="3"
                color="@{vars.accentColor}"
                cornerRadius="@{vars.cornerRadius}"
                focusOnly="true"
                focusTransitionSpeed="@{vars.focusTransitionSpeed}"
                zIndex="10" />

            <!-- LAYER 10: Focus-only title highlight -->
            <rect
                id="focusHighlight"
                x="0" y="@{vars.infoY}"
                width="100%" height="72"
                color="#2200D9FF"
                cornerRadius="0 0 @{vars.cornerRadius} @{vars.cornerRadius}"
                focusOnly="true"
                focusTransitionSpeed="@{vars.focusTransitionSpeed}"
                zIndex="1" />

        </card>

        <!-- ALTERNATE CARD: Shows different layer combinations -->
        <card id="compactCard" width="@{vars.cellWidth}" height="180">

            <!-- Full-bleed image background -->
            <image
                id="bgImage"
                x="0" y="0"
                width="100%" height="100%"
                src="@{game.hero}"
                cornerRadius="@{vars.cornerRadius}"
                scaleType="cover"
                zIndex="0" />

            <!-- Dark gradient overlay for text (demonstrating new gradient support) -->
            <rect
                id="gradient"
                x="0" y="0"
                width="100%" height="100%"
                color="#00000000"
                gradientStart="#00000000"
                gradientEnd="#CC000000"
                gradientAngle="90"
                cornerRadius="@{vars.cornerRadius}"
                zIndex="1" />

            <!-- Title at bottom -->
            <text
                id="title"
                x="@{vars.paddingSmall}" y="@{vars.paddingSmall}"
                width="95%" height="24"
                text="@{game.title}"
                textSize="@{vars.textSizeTitle}"
                color="@{vars.textColor}"
                fontWeight="bold"
                anchor="bottomLeft"
                zIndex="2" />

            <!-- Subtle border -->
            <border
                id="border"
                x="0" y="0"
                width="100%" height="100%"
                strokeWidth="1"
                color="@{vars.borderColor}"
                cornerRadius="@{vars.cornerRadius}"
                zIndex="3" />

        </card>

        <!-- VIDEO CARD: Demonstrates video layer -->
        <card id="videoCard" width="@{vars.cellWidth}" height="@{vars.cellHeight}">

            <!-- Video background -->
            <video
                id="bgVideo"
                x="0" y="0"
                width="100%" height="@{vars.imageHeight}"
                src="@{vars.testVideo}"
                poster="@{game.hero}"
                autoplay="true"
                loop="true"
                muted="true"
                preload="metadata"
                cornerRadius="@{vars.cornerRadius} @{vars.cornerRadius} 0 0" />

            <!-- Info area background -->
            <rect
                id="infoBg"
                x="0" y="@{vars.imageHeight}"
                width="100%" height="80"
                color="@{vars.cardBgColor}"
                cornerRadius="0 0 @{vars.cornerRadius} @{vars.cornerRadius}"
                anchor="topLeft" />

            <!-- Title -->
            <text
                id="title"
                x="@{vars.paddingSmall}" y="@{vars.infoY}"
                width="95%"
                text="@{game.title}"
                textSize="@{vars.textSizeTitle}"
                color="@{vars.textColor}"
                fontWeight="bold"
                maxLines="1" />

        </card>

        <!-- BUTTON CARD: Demonstrates button layer -->
        <card id="buttonCard" width="@{vars.cellWidth}" height="@{vars.cellHeight}">

            <!-- Background -->
            <rect
                id="bg"
                x="0" y="0"
                width="100%" height="100%"
                color="@{vars.cardBgColor}"
                cornerRadius="@{vars.cornerRadius}"
                borderWidth="1"
                borderColor="@{vars.borderColor}" />

            <!-- Game image -->
            <image
                id="image"
                x="0" y="0"
                width="100%" height="@{vars.imageHeight}"
                src="@{game.hero}"
                cornerRadius="@{vars.cornerRadius} @{vars.cornerRadius} 0 0"
                scaleType="cover" />

            <!-- Title -->
            <text
                id="title"
                x="@{vars.paddingSmall}" y="@{vars.infoY}"
                width="60%"
                text="@{game.title}"
                textSize="@{vars.textSizeBody}"
                color="@{vars.textColor}"
                fontWeight="bold"
                maxLines="1" />

            <!-- Action button using system colors (now with border and fontWeight) -->
            <button
                id="playButton"
                x="@{vars.paddingSmall}" y="@{vars.buttonY}"
                width="80" height="32"
                anchor="topRight"
                text="Play"
                backgroundColor="@color/primary"
                textColor="@color/onPrimary"
                textSize="@{vars.textSizeButton}"
                cornerRadius="16"
                borderWidth="1"
                borderColor="@color/onPrimary"
                fontWeight="bold" />

        </card>

        <!-- BACKDROP CARD: Demonstrates backdrop/blur layer -->
        <card id="backdropCard" width="@{vars.cellWidth}" height="180">

            <!-- Full image -->
            <image
                id="bgImage"
                x="0" y="0"
                width="100%" height="100%"
                src="@{game.hero}"
                cornerRadius="@{vars.cornerRadius}"
                scaleType="cover"
                zIndex="0" />

            <!-- Backdrop blur effect at bottom -->
            <backdrop
                id="blur"
                x="0" y="0"
                width="100%" height="60"
                blurRadius="10"
                tintColor="#88000000"
                anchor="bottomLeft"
                zIndex="1" />

            <!-- Title over blur -->
            <text
                id="title"
                x="@{vars.paddingSmall}" y="@{vars.paddingSmall}"
                width="95%"
                text="@{game.title}"
                textSize="@{vars.textSizeTitle}"
                color="@{vars.textColor}"
                fontWeight="bold"
                anchor="bottomLeft"
                zIndex="2" />

            <!-- Border -->
            <border
                id="border"
                x="0" y="0"
                width="100%" height="100%"
                strokeWidth="1"
                color="@{vars.borderColor}"
                cornerRadius="@{vars.cornerRadius}"
                zIndex="3" />

        </card>

    </elements>

    <!-- ================================================================
         LAYOUT - What's actually rendered on screen (in declaration order)
         ================================================================ -->
    <layout>
        <!-- TOP BAR: Header, Search, and Profile (inline definition) -->
        <fixed id="topBar" backgroundColor="@{vars.topBarBg}" height="@{vars.topBarHeight}"
               padding="8" cornerRadius="0">

            <!-- HEADER: App name, theme name, game count -->
            <header
                x="@{vars.paddingMedium}"
                y="@{vars.paddingSmall}"
                anchor="topLeft"
                textColor="@{vars.textColor}"
                showAppName="true"
                showThemeName="true"
                showGameCount="true"
                highlightColor="@{vars.highlightColor}"
                highlightOpacity="@{vars.highlightOpacity}"
                highlightBorderWidth="@{vars.highlightBorderWidth}"
                highlightTransitionSpeed="@{vars.highlightTransitionSpeed}" />

            <!-- SEARCH BAR: With full styling options -->
            <searchBar
                x="@{vars.searchBarX}"
                y="@{vars.searchBarY}"
                width="@{vars.searchBarWidth}"
                height="@{vars.searchBarHeight}"
                anchor="topLeft"
                backgroundColor="@{vars.searchBarBg}"
                borderRadius="@{vars.searchBarRadius}"
                collapsible="false"
                highlightColor="@{vars.highlightColor}"
                highlightOpacity="@{vars.highlightOpacity}"
                highlightBorderWidth="@{vars.highlightBorderWidth}"
                highlightTransitionSpeed="@{vars.highlightTransitionSpeed}" />

            <!-- PROFILE BUTTON: User account access -->
            <profileButton
                x="@{vars.profileButtonX}"
                y="@{vars.profileButtonY}"
                anchor="topRight"
                size="@{vars.profileButtonSize}"
                iconSize="@{vars.profileButtonIconSize}"
                padding="@{vars.profileButtonPadding}"
                backgroundColor="@{vars.profileButtonBg}"
                cornerRadius="@{vars.profileButtonRadius}"
                highlightColor="@{vars.highlightColor}"
                highlightOpacity="@{vars.highlightOpacity}"
                highlightBorderWidth="@{vars.highlightBorderWidth}"
                highlightTransitionSpeed="@{vars.highlightTransitionSpeed}" />
        </fixed>

        <!-- DECORATIVE ELEMENTS: Demonstrating fixed image and video elements -->
        <fixed id="decorativeBar" visibility="landscape">
            <!-- FIXED IMAGE: Static decorative image (not bound to game data) -->
            <image
                x="20"
                y="20"
                width="100"
                height="100"
                anchor="topRight"
                src="assets/Atomic Bomberman.jpg"
                scaleType="cover"
                cornerRadius="12"
                opacity="0.9"
                visibility="landscape" />

            <!-- FIXED VIDEO: Local video with local poster -->
            <video
                x="20"
                y="120"
                width="120"
                height="80"
                anchor="topRight"
                src="assets/sample.mp4"
                poster="assets/sample-poster.png"
                autoplay="true"
                loop="true"
                muted="true"
                cornerRadius="8"
                opacity="0.95"
                visibility="landscape" />

            <!-- FIXED VIDEO: External video with external poster (Big Buck Bunny) -->
            <video
                x="20"
                y="250"
                width="160"
                height="90"
                anchor="topRight"
                src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4"
                poster="https://upload.wikimedia.org/wikipedia/commons/thumb/c/c5/Big_buck_bunny_poster_big.jpg/800px-Big_buck_bunny_poster_big.jpg"
                autoplay="true"
                loop="true"
                muted="true"
                cornerRadius="12"
                opacity="1.0"
                visibility="landscape" />
        </fixed>

        <!-- GRID LAYOUT with inline card definition (demonstrates new inline card feature) -->
        <grid
            cellWidth="@{vars.cellWidth}"
            cellHeight="@{vars.cellHeight}"
            hSpacing="@{vars.hSpacing}"
            vSpacing="@{vars.vSpacing}"
            padding="@{vars.gridPaddingTop} @{vars.paddingLarge} 80 @{vars.paddingLarge}"
            verticalAlign="center"
            selectionMode="moving">

            <!-- INLINE CARD: Defined directly inside grid (no itemCard attribute needed) -->
            <card width="300" height="300">
                <image
                    id="image"
                    x="0" y="0"
                    width="200" height="200"
                    src="@{game.hero}"
                    cornerRadius="@{vars.cornerRadius}"
                    scaleType="cover"
                    zIndex="0" />
            </card>

            <!-- SEPARATOR: Decorative line between rows -->
            <separator height="1" margin="@{vars.separatorMargin} 0">
                <rect
                    x="0" y="0"
                    width="100%" height="1"
                    color="@{vars.separatorColor}" />
            </separator>

        </grid>

        <!-- BOTTOM BAR: Action buttons -->
        <fixed id="bottomBar">
            <!-- FILTER BUTTON: Opens filter bottom sheet -->
            <filterButton
                x="100"
                y="@{vars.bottomOffset}"
                anchor="bottomRight"
                expanded="true"
                size="56"
                iconSize="24"
                cornerRadius="16"
                highlightColor="@{vars.highlightColor}"
                highlightOpacity="@{vars.highlightOpacity}"
                highlightBorderWidth="@{vars.highlightBorderWidth}"
                highlightTransitionSpeed="@{vars.highlightTransitionSpeed}" />

            <!-- ADD BUTTON: Add custom games -->
            <addButton
                x="@{vars.paddingMedium}"
                y="@{vars.bottomOffset}"
                anchor="bottomRight"
                size="56"
                iconSize="24"
                cornerRadius="16"
                highlightColor="@{vars.highlightColor}"
                highlightOpacity="@{vars.highlightOpacity}"
                highlightBorderWidth="@{vars.highlightBorderWidth}"
                highlightTransitionSpeed="@{vars.highlightTransitionSpeed}" />
        </fixed>

    </layout>

</theme>
